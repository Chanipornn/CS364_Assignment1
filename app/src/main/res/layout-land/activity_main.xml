<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ================= HEADER ================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:paddingTop="@dimen/land_header_padding_vertical"
            android:paddingBottom="@dimen/land_header_padding_vertical">

            <!-- Logo -->

            <ImageView
                android:id="@+id/bmiLogo"
                android:layout_width="@dimen/land_logo_width"
                android:layout_height="@dimen/land_logo_height"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/land_logo_margin_start"
                android:src="@drawable/bmi_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/title_bmi" />


            <!-- Center Title -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_bmi"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/land_header_title_size"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/land_header_subtitle_margin"
                    android:text="@string/subtitle_bmi"
                    android:textColor="@color/text_white"
                    android:alpha="0.9"
                    android:textSize="@dimen/land_header_subtitle_size"
                    android:gravity="center" />

            </LinearLayout>

        </FrameLayout>


        <!-- ================= CONTENT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/land_content_padding_horizontal"
            android:paddingEnd="@dimen/land_content_padding_horizontal"
            android:paddingTop="@dimen/land_content_padding_vertical"
            android:paddingBottom="@dimen/land_content_padding_vertical"
            android:baselineAligned="false">


            <!-- ================= LEFT : INPUT ================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="@dimen/land_column_padding">


                <!-- Weight -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/weight"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/label_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/land_label_margin_bottom" />

                <EditText
                    android:id="@+id/weightEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/edittext_background"
                    android:hint="@string/weight_hint"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/input_text_size"
                    android:paddingStart="@dimen/input_padding"
                    android:paddingEnd="@dimen/input_padding"
                    android:layout_marginBottom="@dimen/land_input_margin_bottom" />


                <!-- Height -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/height"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/label_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/land_label_margin_bottom" />

                <EditText
                    android:id="@+id/heightEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/edittext_background"
                    android:hint="@string/height_hint"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/input_text_size"
                    android:paddingStart="@dimen/input_padding"
                    android:paddingEnd="@dimen/input_padding"
                    android:layout_marginBottom="@dimen/land_height_margin_bottom" />


                <!-- Calculate -->

                <Button
                    android:id="@+id/calculateButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:text="@string/calculate"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/button_text_size"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent_yellow" />

            </LinearLayout>


            <!-- ================= RIGHT : RESULT ================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="@dimen/land_column_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/land_result_min_height"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/result_card"
                    android:elevation="@dimen/card_elevation"
                    android:padding="@dimen/land_result_padding">


                    <!-- BMI -->

                    <TextView
                        android:id="@+id/bmiLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/label_size"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/bmiResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi_placeholder"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/result_size"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/land_result_margin_top"
                        android:gravity="center" />


                    <!-- Yellow Divider -->

                    <View
                        android:layout_width="@dimen/land_divider_width"
                        android:layout_height="@dimen/land_divider_height"
                        android:background="@color/accent_yellow"
                        android:layout_marginTop="@dimen/land_divider_margin_top"
                        android:layout_marginBottom="@dimen/land_divider_margin_bottom" />


                    <!-- Category -->

                    <TextView
                        android:id="@+id/categoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi_category"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/label_size"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/categoryResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_placeholder"
                        android:textColor="@color/normal_color"
                        android:textSize="@dimen/category_result_size"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/land_result_margin_top"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>